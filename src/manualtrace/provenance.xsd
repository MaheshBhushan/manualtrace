<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:manualtrace:provenance">
  <xs:attribute name="doc">
    <xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/></xs:restriction></xs:simpleType>
  </xs:attribute>
  <xs:attribute name="page" type="xs:positiveInteger"/>
  <!-- left,top,right,bottom in PDF points, top-left origin -->
  <xs:attribute name="bbox">
    <xs:simpleType><xs:restriction base="xs:string">
      <xs:pattern value="-?[0-9]+\.[0-9],-?[0-9]+\.[0-9],-?[0-9]+\.[0-9],-?[0-9]+\.[0-9]"/>
    </xs:restriction></xs:simpleType>
  </xs:attribute>
  <xs:attribute name="more">
    <xs:simpleType><xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+:[0-9.,\-]+(;[0-9]+:[0-9.,\-]+)*"/>
    </xs:restriction></xs:simpleType>
  </xs:attribute>
  <xs:attribute name="label" type="xs:string"/>
</xs:schema>
